# ==============================================================================
# CivicMind AI — Backend Configuration (.env.example)
# ==============================================================================

# Application Metadata
PROJECT_NAME="CivicMind AI Intelligence Backend"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Settings (JSON string list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL 16 + pgvector Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="civicmind_user"
POSTGRES_PASSWORD="civicmind_dev_password_change_in_prod"
POSTGRES_DB="civicmind_db"

# Optional explicit DATABASE_URL overrides (AsyncPG & Sync driver for Alembic)
# DATABASE_URL="postgresql+asyncpg://civicmind_user:civicmind_dev_password_change_in_prod@localhost:5432/civicmind_db"
# DATABASE_URL_SYNC="postgresql://civicmind_user:civicmind_dev_password_change_in_prod@localhost:5432/civicmind_db"

# Redis 7 Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
# REDIS_URL="redis://localhost:6379/0"

# Celery Background Processing Infrastructure
# CELERY_BROKER_URL="redis://localhost:6379/0"
# CELERY_RESULT_BACKEND="redis://localhost:6379/0"
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_ALWAYS_EAGER=false
NOTIFICATION_PROVIDER="logging"
EVIDENCE_CLEANUP_RETENTION_HOURS=24

# Vector Embedding Configuration (pgvector dimension)
EMBEDDING_DIMENSION=768
DEFAULT_EMBEDDING_MODEL="paraphrase-multilingual-mpnet-base-v2"

# Security
SECRET_KEY="dev_insecure_secret_key_civicmind_ai_replace_for_production_use"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback/google"
